# Whitelist: ignore everything, then allow only this project's own code.
# Never commit gen/, gen_full/ (code generated from the game), orig.bin, build output or game data.
/*
!/.gitignore
!/.gitmodules
!/.github/
!/README.md
!/LICENSE
!/Makefile
!/framework
!/src/
!/scripts/
!/setup/
!/packaging/
!/tests/
!/docs/
!/tools/
/tools/*
!/tools/hle.txt
.DS_Store
__pycache__/
